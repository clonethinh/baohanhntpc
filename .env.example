# ==============================================================
# NTPC Bảo Hành - File cấu hình mẫu
# Copy file này thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore)
# ==============================================================

# --- Bảo mật / Xác thực ---
# Chuỗi bí mật ký JWT/session. Tạo chuỗi ngẫu nhiên dài:  openssl rand -hex 32
AUTH_SECRET=thay-bang-chuoi-ngau-nhien-dai-toi-thieu-32-ky-tu
# Mật khẩu mặc định cấp cho nhân viên khi khởi tạo lần đầu (đổi ngay sau khi đăng nhập)
INITIAL_STAFF_PASSWORD=doi-mat-khau-nay
# Thời gian sống của session (giây). 86400 = 1 ngày
SESSION_TTL_SECONDS=86400
# Bật cookie Secure (chỉ gửi qua HTTPS). true cho production, false khi dev localhost
COOKIE_SECURE=true

# --- API ---
# Cổng nội bộ của backend Express (trong container). Mặc định 3003
API_PORT=3003
# Origin được phép gọi API (CORS). Domain frontend thật của bạn
CORS_ORIGIN=https://baohanh.nguyentanpc.com

# --- PostgreSQL ---
POSTGRES_USER=ntpc_user
POSTGRES_PASSWORD=thay-bang-mat-khau-db-manh
POSTGRES_DB=ntpc_warranty
# Chuỗi kết nối Prisma. Giữ host=postgres-db, port=5432 (mạng nội bộ Docker)
# Phải khớp POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB ở trên
DATABASE_URL=postgresql://ntpc_user:thay-bang-mat-khau-db-manh@postgres-db:5432/ntpc_warranty?schema=public
